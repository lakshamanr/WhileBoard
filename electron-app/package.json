{
  "name": "collaborative-whiteboard-desktop",
  "version": "1.0.0",
  "description": "Collaborative Whiteboard Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": ["whiteboard", "collaborative", "electron"],
  "author": "Collaborative Whiteboard Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.whiteboard.collaborative",
    "productName": "Collaborative Whiteboard",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "frontend/**/*",
      "api/**/*"
    ],
    "asarUnpack": [
      "api/**/*",
      "frontend/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "icon.png",
      "category": "Office"
    }
  }
}
